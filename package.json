{
  "name": "vevit-games",
  "private": true,
  "version": "0.1.0",
  "description": "VeVit Games — herní portál vevit.fun",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vevit-games/portal dev",
    "dev:api": "pnpm --filter @vevit-games/api dev",
    "build": "node scripts/check-ip.mjs && pnpm typecheck && pnpm --filter @vevit-games/portal build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/rules --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fonts": "node scripts/fetch-fonts.mjs",
    "smoke": "node scripts/smoke-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
