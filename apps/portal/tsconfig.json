{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // sw.ts se kontroluje zvlášť přes tsconfig.sw.json — potřebuje
  // WebWorker lib místo DOM.
  "exclude": ["src/sw.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "offline/**/*.ts", "vite.config.ts"]
}
