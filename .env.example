# Zkopíruj na serveru jako .env (chmod 600). Do repa nikdy necommitovat.

NODE_ENV=production
TZ=Europe/Prague

# --- Registr a deploy -------------------------------------------------------
REGISTRY=ghcr.io/vedry32
TAG=latest
ACME_EMAIL=

# --- Databáze ---------------------------------------------------------------
# Postgres (Supabase nebo vlastní). API se připojuje service rolí.
DATABASE_URL=postgres://user:heslo@host:5432/postgres
DATABASE_SCHEMA=games

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth -------------------------------------------------------------------
# local | vevit-sso
AUTH_PROVIDER=local
# Náhodných 64 bajtů: openssl rand -hex 64
SESSION_SECRET=
SESSION_COOKIE=__Host-vvfsession
SESSION_TTL_DAYS=30
# Jen pro AUTH_PROVIDER=vevit-sso — sdílené tajemství pro výměnu ticketu
VEVIT_SSO_URL=https://vevit.cz/api/sso/verify
VEVIT_SSO_SECRET=

# --- Realtime ---------------------------------------------------------------
RT_PUBLIC_URL=wss://rt.vevit.fun/ws
# openssl rand -hex 32 — podpis jednorázových ticketů (platnost 60 s)
RT_TICKET_SECRET=
RT_ALLOWED_ORIGINS=https://vevit.fun,https://www.vevit.fun

# --- Origin ochrana ---------------------------------------------------------
# Jen pokud portál běží za cizím reverse proxy (viz D-002); jinak nech prázdné.
ORIGIN_KEY=

# --- Zálohy -----------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_HEALTHCHECK_URL=
